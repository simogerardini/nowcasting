# TLS: Let's Encrypt via HTTP-01 (works behind the Cloudflare proxy) -> compatible with SSL "Full (strict)".
{
	email {$ACME_EMAIL:admin@noctalix.com}
}

{$API_DOMAIN:api-nowcast.noctalix.com} {
	encode zstd gzip
	header -Server
	reverse_proxy api:8000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
