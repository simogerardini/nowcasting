# Database & Redis
POSTGRES_USER=noctalix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nowcast
DATABASE_URL=postgresql+asyncpg://noctalix:change-me@db:5432/nowcast
REDIS_URL=redis://redis:6379/0

# Web Push VAPID Keys (empty = auto-generated once and persisted in /data/vapid.json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@noctalix.com

# Cloudflare R2 (S3 Compatible) - empty = assets served by the API at /assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=noctalix-nowcast-assets
R2_PUBLIC_URL=https://assets-nowcast.noctalix.com

# EUMETSAT Data Store (MTG Lightning Imager) - free key at https://api.eumetsat.int
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Cloudflare Tunnel for api-nowcast.noctalix.com
CLOUDFLARE_TUNNEL_TOKEN=

# API
CORS_ORIGINS=https://nowcast.noctalix.com
FRONTEND_URL=https://nowcast.noctalix.com
RADAR_PRODUCT=VMI

# Frontend (build-time)
NEXT_PUBLIC_API_URL=https://api-nowcast.noctalix.com
NEXT_PUBLIC_ASSETS_URL=https://assets-nowcast.noctalix.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
